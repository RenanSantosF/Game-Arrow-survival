func _ready() -> void:
	for pair in [["en", EN], ["es", ES]]:
		var t := Translation.new()
		t.locale = pair[0]
		for key in pair[1]:
			t.add_message(key, pair[1][key])
		TranslationServer.add_translation(t)
	apply()


## Idioma em uso agora (pt, en ou es).
func current() -> String:
	if GameData.language in LANGUAGES:
		return GameData.language
	return device_language()


func device_language() -> String:
	var lang := OS.get_locale_language()
	if lang == "pt" or lang == "es":
		return lang
	return "en"


func apply() -> void:
	TranslationServer.set_locale(current())


## Passa para o próximo idioma (botão do menu) e salva.
func cycle() -> void:
	var i := LANGUAGES.find(current())
	GameData.language = LANGUAGES[(i + 1) % LANGUAGES.size()]
	apply()
	GameData.save_data()
